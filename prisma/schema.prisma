datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id               String   @id @default(cuid())
  registrationId   String   @unique
  fullName         String
  phone            String
  whatsappNumber   String
  email            String
  businessType     String   @default("Exporter")
  businessName     String?
  city             String   @default("India")
  state            String?
  country          String   @default("India")
  interestedIn     String   @default("Business Networking")
  source           String?
  rejectionReason  String?
  status           String   @default("PENDING_PAYMENT")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments         Payment[]
  whatsappMessages WhatsAppMessage[]
  auditLogs        AuditLog[]

  @@index([phone])
  @@index([email])
  @@index([status])
  @@map("customers")
}

model Payment {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId         String   @unique
  paymentId       String?
  amount          Int      @default(19900)
  currency        String   @default("INR")
  gateway         String   @default("CASHFREE")
  status          String   @default("PENDING")
  gatewayResponse String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model WhatsAppMessage {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messageType       String
  recipient         String
  message           String
  providerMessageId String?
  status            String   @default("SENT")
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([customerId])
  @@map("whatsapp_messages")
}

model AdminUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("ADMIN")
  createdAt    DateTime   @default(now())

  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id          String     @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  action      String
  description String
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}
